APP_NAME="Facebook Post Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# Web UI admin account (required to log in). Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# Phase 1 crawler (Docker mounts ../crawler_mebe at /var/www/crawler; host: ../crawler_mebe)
CRAWLER_PATH=/var/www/crawler
CRAWLER_MAX_POSTS=50
CRAWLER_MAX_SCROLLS=15
CRAWLER_TIMEOUT_SECONDS=300
CRAWLER_QUEUE=crawler
CRAWLER_MAX_CONCURRENT=1
CRAWLER_STALE_AFTER_MINUTES=180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crawler_mebe
DB_USERNAME=crawler
DB_PASSWORD=
# Case-insensitive, accent-sensitive: "BÁN" matches "bán" but not "bạn"
DB_COLLATION=utf8mb4_0900_as_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest crawl job timeout (200 posts: ~1800 s + 120), or a running crawl is started twice.
DB_QUEUE_RETRY_AFTER=2100

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
